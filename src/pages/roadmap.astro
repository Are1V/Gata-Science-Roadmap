---
import Layout from '../layouts/Layout.astro';
import Roadmap from '../components/Roadmap';
import ConnectionMap from '../components/ConnectionMap';
import { specializations, phases } from '../data/roadmap';
import { ArrowUpRight, GitBranch } from 'lucide-react';
import { url } from '../utils/urls';
---

<Layout title="Roadmap" active="Roadmap">
  <div class="page-heading roadmap-page-heading">
    <h1>Data science roadmap</h1>
    <p>Watch a lesson. Build something. Keep going.</p>
  </div>
  <Roadmap client:load />
  <ConnectionMap client:visible />
  <section id="paths">
    <div class="section-heading">
      <div>
        <h2>Choose a specialization</h2>
      </div>
    </div>
    <div class="specialization-grid">
      {specializations.map((s) => (
        <article class="specialization-card">
          <div class="card-top">
            <GitBranch size={20} />
            <span class="tag">{s.phases.length} chapters</span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
          <details>
            <summary>View recommended chapters</summary>
            <div class="dependency-links">
              {s.phases.map((n) => (
                <a href={url(`learn/${phases[n].id}/`)}>{phases[n].title}</a>
              ))}
            </div>
          </details>
          <a class="text-link" href={url(`roadmap/?path=${s.id}`)}>
            Explore this path <ArrowUpRight size={14} />
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>
