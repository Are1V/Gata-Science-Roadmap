---
import Layout from '../layouts/Layout.astro';
import Library from '../components/Library';
---

<Layout title="Resources" active="Resources">
  <div class="page-heading">
    <span class="eyebrow">GOOD SOURCES. NO PAYWALLS.</span>
    <h1>A smaller, better reading list.</h1>
    <p>
      Official documentation, university courses, and open textbooks. Every resource is free to
      read; some courses offer optional paid certificates.
    </p>
  </div>
  <Library type="resources" client:load />
</Layout>
