---
import Layout from '../../layouts/Layout.astro';
import { phases } from '../../data/roadmap';
import { learningOrder } from '../../data/learning';
import TopicList from '../../components/TopicList';
import { ArrowLeft, ArrowRight, Flag } from 'lucide-react';
import projects from '../../content/projects/projects.json';
import { projectMilestones } from '../../data/map';
import { url } from '../../utils/urls';
export function getStaticPaths() {
  return phases.map((phase) => ({ params: { id: phase.id }, props: { phase } }));
}
const { phase } = Astro.props;
const project = projects.find((p) => p.id === projectMilestones[phase.number]);
const index = learningOrder.indexOf(phase.number);
const next = phases[learningOrder[index + 1]];
---

<Layout title={phase.title} active="Roadmap">
  <a href={url('roadmap/')} class="back-link">
    <ArrowLeft size={14} />
    Back to the map
  </a>
  <div class="page-heading compact-chapter-heading">
    <span class="eyebrow">
      {phase.level} · {phase.topics.length} topics
    </span>
    <h1>{phase.title}</h1>
    <p>{phase.description}</p>
  </div>
  <div class="compact-chapter">
    <TopicList phase={phase.number} client:load />
    {project && (
      <section class="topic-practice">
        <div>
          <h2>
            <Flag size={18} /> {project.title}
          </h2>
          <p>{project.problem}</p>
        </div>
        <a class="text-link" href={url(`projects/#${project.id}`)}>
          Start practice
          <ArrowRight size={14} />
        </a>
      </section>
    )}
    {next && (
      <a class="text-link chapter-next" href={url(`learn/${next.id}/`)}>
        Next: {next.title}
        <ArrowRight size={14} />
      </a>
    )}
  </div>
</Layout>
