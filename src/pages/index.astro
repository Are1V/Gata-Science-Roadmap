---
import Layout from '../layouts/Layout.astro';
import {
  ArrowRight,
  ArrowUpRight,
  Check,
  Route,
  FolderKanban,
  GitBranch,
  BookOpen,
  Sigma,
  BrainCircuit,
  CodeXml,
  ChartNoAxesCombined,
  Sparkles,
  Sprout,
  Heart,
  CircleCheck,
  MousePointer2,
  ChartPie,
  Library,
} from 'lucide-react';
import { topics, resources, specializations, phases } from '../data/roadmap';
import projects from '../content/projects/projects.json';
import { url } from '../utils/urls';
const cards = [
  {
    title: 'Explore the roadmap',
    description:
      'Browse the curriculum in seven sections. Open a chapter to see its topics and prerequisites.',
    icon: Route,
    color: '',
    tag: 'CURRICULUM',
    footer: `${phases.length} phases · Beginner to advanced`,
    href: 'roadmap/',
  },
  {
    title: 'Understand the math',
    description:
      'Study linear algebra, calculus, probability, and statistics with worked examples.',
    icon: Sigma,
    color: 'green',
    tag: 'FOUNDATIONS',
    footer: 'Linear algebra · Calculus · Probability',
    href: 'mathematics/',
  },
  {
    title: 'Build projects',
    description: 'Practice each stage with a concrete problem, deliverables, and review criteria.',
    icon: FolderKanban,
    color: 'sand',
    tag: 'PRACTICE',
    footer: `${projects.length} projects · All skill levels`,
    href: 'projects/',
  },
];
---

<Layout title="Home">
  <section class="home-hero">
    <div class="hero-copy">
      <div class="eyebrow">
        <span class="eyebrow-dot" />
        FREE, OPEN-SOURCE LEARNING MAP
      </div>
      <h1>
        Data science,
        <br />
        <span>step by step.</span>
      </h1>
      <p>
        Start with Python and data, build the math and statistics, then learn to train, evaluate,
        and deploy models. Each chapter links to topics, prerequisites, and projects.
      </p>
      <div class="hero-actions">
        <a class="button" href={url('roadmap/')}>
          Open the roadmap <ArrowRight size={15} />
        </a>
        <a class="button secondary" href={url('learn/getting-started/')}>
          Start learning <ArrowUpRight size={14} />
        </a>
      </div>
      <div class="hero-note">
        <CircleCheck size={12} />
        Free to use. No account required. Progress stays in your browser.
      </div>
    </div>
    <div
      class="hero-map"
      aria-label="A learning path from Python to mathematics, statistics, and machine learning"
    >
      <span class="map-note">Start here and follow the links</span>
      <svg class="mini-path" viewBox="0 0 430 336" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M212 65 V100 M210 134 V155 Q210 168 195 168 H103 Q87 168 87 185 M210 151 V155 Q210 168 226 168 H339 Q354 168 354 185 M87 211 V230 Q87 245 104 245 H196 Q211 245 211 264 M354 211 V230 Q354 245 337 245 H227 Q211 245 211 264 M211 295 V318"
          stroke-dasharray="4 4"
        />
      </svg>
      <a href={url('learn/getting-started/')} class="mini-node start">
        <Sprout size={14} />
        Start here <Check size={12} />
      </a>
      <a href={url('learn/python-foundations/')} class="mini-node python">
        <CodeXml size={18} />
        Python foundations
        <span class="tiny-dot" />
      </a>
      <a href={url('mathematics/')} class="mini-node math">
        <Sigma size={18} />
        Mathematics
      </a>
      <a href={url('statistics/')} class="mini-node stats">
        <ChartNoAxesCombined size={17} />
        Statistics
      </a>
      <a href={url('machine-learning/')} class="mini-node ml">
        <BrainCircuit size={18} />
        Machine learning
        <ArrowRight size={13} />
      </a>
      <span class="map-caption">
        <MousePointer2 size={10} />
        OPEN A CHAPTER TO SEE ITS TOPICS
      </span>
    </div>
  </section>
  <section class="stats-band" aria-label="Curriculum at a glance">
    {[
      { value: topics.length, label: 'Checklist topics', icon: Route },
      { value: projects.length, label: 'Hands-on projects', icon: FolderKanban },
      { value: specializations.length, label: 'Learning paths', icon: GitBranch },
      { value: resources.length, label: 'Free resources', icon: BookOpen },
    ].map(({ value, label, icon: Icon }) => (
      <div class="stat">
        <div class="stat-icon">
          <Icon size={18} strokeWidth={1.5} />
        </div>
        <div>
          <strong>{value}</strong>
          <span>{label}</span>
        </div>
      </div>
    ))}
  </section>
  <section>
    <div class="section-heading">
      <div>
        <h2>Choose where to start</h2>
        <p>Follow the roadmap, study the foundations, or practice with a project.</p>
      </div>
      <a href={url('roadmap/')} class="text-link">
        View all chapters <ArrowRight size={13} />
      </a>
    </div>
    <div class="overview-grid">
      {cards.map(({ title, description, icon: Icon, color, tag, footer, href }) => (
        <a class="overview-card" href={url(href)}>
          <div class="card-top">
            <span class:list={['card-icon', color]}>
              <Icon size={21} strokeWidth={1.5} />
            </span>
            <span class="tag">{tag}</span>
          </div>
          <h3>{title}</h3>
          <p>{description}</p>
          <div class="card-footer">
            <span>{footer}</span>
            <ArrowUpRight size={16} />
          </div>
        </a>
      ))}
    </div>
  </section>
  <section class="learning-banner">
    <div class="banner-icon">
      <Sparkles size={22} strokeWidth={1.4} />
    </div>
    <div>
      <h3>Understand why a model works</h3>
      <p>
        See how vectors become predictions, derivatives train models, and probability brings it all
        together.
      </p>
    </div>
    <a href={url('topics/linear-regression/')} class="text-link">
      Read a worked example <ArrowRight size={14} />
    </a>
  </section>
  <section>
    <div class="section-heading">
      <div>
        <h2>Choose a specialization</h2>
        <p>Use the same foundation, then focus on the work you want to do.</p>
      </div>
      <a class="text-link" href={url('roadmap/#paths')}>
        Explore all {specializations.length} paths <ArrowRight size={13} />
      </a>
    </div>
    <div class="path-grid">
      {[
        {
          title: 'Machine Learning Scientist',
          text: 'Build models. Solve hard problems.',
          icon: BrainCircuit,
          id: 'ml',
        },
        {
          title: 'Product Data Scientist',
          text: 'Better questions. Better decisions.',
          icon: ChartPie,
          id: 'product',
        },
        {
          title: 'Analytics Data Scientist',
          text: 'Find patterns. Tell meaningful stories.',
          icon: Library,
          id: 'analytics',
        },
      ].map(({ title, text, icon: Icon, id }) => (
        <a class="path-card" href={url(`roadmap/?path=${id}`)}>
          <Icon size={21} strokeWidth={1.3} />
          <div>
            <strong>{title}</strong>
            <small>{text}</small>
          </div>
          <ArrowUpRight size={14} />
        </a>
      ))}
    </div>
  </section>
  <div class="home-bottom-note">
    <Heart size={12} /> Built for students, career switchers, and people who never stop asking why.
  </div>
</Layout>
